nan = float("nan")

def guardar_en_excel(registros, archivo="edades_ingresadas.xlsx"):
    if not registros:
        print("No se ingresaron edades: no se guardó nada.")
        return
    try:
        from openpyxl import Workbook, load_workbook
        if os.path.exists(archivo):
            libro = load_workbook(archivo)
            hoja = libro.active
        else:
            libro = Workbook()
            hoja = libro.active
            hoja.append(["Edad ingresada", "Resultado"])
        for fila in registros:
            hoja.append(list(fila))
        libro.save(archivo)
        print("Edades guardadas en:", os.path.abspath(archivo))
    except ImportError:
        print("Falta la librería openpyxl (pip install openpyxl): no se pudo guardar el Excel.")
    except PermissionError:
        print("No se pudo guardar: cierre", archivo, "si lo tiene abierto en Excel.")



def procesar(lista, validador, etiqueta="Elemento", *args):
    validos = invalidos = 0
    for posicion, dato in enumerate(lista, 1):
        if validador(dato, *args):
            validos += 1
            print(f"{etiqueta} {posicion}: {dato} -> válido")
        else:
            invalidos += 1
            print(f"{etiqueta} {posicion}: {dato} -> inválido")
    print(f"Total válidos: {validos} | inválidos: {invalidos} | total: {validos + invalidos}")
    return validos, invalidos


def leer_n(mensaje, validador):
    validos = invalidos = 0
    for i in range(1, int(input("¿Cuántos datos desea ingresar? ")) + 1):
        if validador(input(f"{mensaje} {i}: ")):
            print("  -> válido")
            validos += 1
        else:
            print("  -> inválido")
            invalidos += 1
    print(f"Válidos: {validos} | Inválidos: {invalidos}")


def leer_hasta(mensaje, salida, validador):
    validos, invalidos = [], 0
    while (dato := input(f"{mensaje} (o '{salida}'): ")) != salida:
        if validador(dato):
            print("  -> válido")
            validos.append(dato)
        else:
            print("  -> inválido")
            invalidos += 1
    print(f"Válidos: {len(validos)} | Inválidos: {invalidos}")
    return validos, invalidos


